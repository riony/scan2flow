#!/bin/bash
# scan2flow RANS template — clean generated files, keep the case definition.
# Preserves: system/, constant/triSurface/, constant/*Properties, 0.orig/.
cd "${0%/*}" || exit 1
. "${WM_PROJECT_DIR:?}/bin/tools/CleanFunctions"

cleanCase                       # time dirs, processor*, postProcessing, logs
rm -rf 0
rm -rf constant/polyMesh
rm -rf constant/extendedFeatureEdgeMesh
rm -f  constant/triSurface/*.eMesh
rm -f  ./*.foam
echo "Cleaned. (constant/triSurface STL and system/ kept.)"
