/*--------------------------------*- C++ -*----------------------------------*\
| scan2flow template — background mesh. Half-body car domain (~4.6 m car).        |
| Car nose near x=0, body spans ~0..4.6, symmetry plane at y=0, ground z=0.    |
| Extents (multiples of car length L≈4.6): 3L upstream, ~8L downstream,        |
| 2.5L half-width, 3L height. Base cell ~0.7 m; snappyHexMesh refines.         |
| The generator (pipeline/mesh.py) rewrites extents/counts per geometry.       |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

xMin   -14;  xMax   42;
yMin     0;  yMax  11.5;     // y=0 is the symmetry plane (half body)
zMin     0;  zMax    14;

// cell counts (base cell ~0.7 m)
nx 80;  ny 16;  nz 20;

vertices
(
    ($xMin $yMin $zMin)   // 0
    ($xMax $yMin $zMin)   // 1
    ($xMax $yMax $zMin)   // 2
    ($xMin $yMax $zMin)   // 3
    ($xMin $yMin $zMax)   // 4
    ($xMax $yMin $zMax)   // 5
    ($xMax $yMax $zMax)   // 6
    ($xMin $yMax $zMax)   // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx $ny $nz) simpleGrading (1 1 1)
);

edges ( );

boundary
(
    inlet
    {
        type patch;
        faces ( (0 4 7 3) );
    }
    outlet
    {
        type patch;
        faces ( (1 2 6 5) );
    }
    ground
    {
        type wall;
        faces ( (0 1 2 3) );
    }
    top
    {
        type patch;
        faces ( (4 7 6 5) );
    }
    symmetry
    {
        type symmetry;
        faces ( (0 4 5 1) );
    }
    sides
    {
        type patch;
        faces ( (3 2 6 7) );
    }
);

mergePatchPairs ( );

// ************************************************************************* //
