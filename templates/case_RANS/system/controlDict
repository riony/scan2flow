/*--------------------------------*- C++ -*----------------------------------*\
| scan2flow RANS template — simpleFoam steady-state controlDict.                  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "include/caseDefinition"

application     simpleFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         3000;

deltaT          1;

writeControl    timeStep;
writeInterval   500;
purgeWrite      2;

writeFormat     binary;
writePrecision  10;
writeCompression off;

timeFormat      general;
timePrecision   7;

runTimeModifiable yes;

libs            ( "libforces.so" );

functions
{
    #include "include/forceCoeffs"

    // solve-time lambda2 (vortex visualization field) — written with every output
    // time so the viz pipeline never needs a postProcess pass (see
    // validation/vortex_visualization_bakeoff.md)
    Lambda2
    {
        type            Lambda2;
        libs            (fieldFunctionObjects);
        executeControl  writeTime;
        writeControl    writeTime;
    }

    residuals
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          (U p k omega);
        writeResidualFields no;
    }

    yPlus
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
    }

    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
        patches         ( $carPatches );
    }

    // surface pressure coefficient Cp for surface viz / dataset
    pressureCoeff
    {
        type            pressure;
        libs            (fieldFunctionObjects);
        mode            staticCoeff;
        rho             rhoInf;
        rhoInf          $rhoInf;
        pInf            $pref;
        UInf            $UinfVec;
        result          Cp;
        writeControl    writeTime;
    }
}

// ************************************************************************* //
