/*--------------------------------*- C++ -*----------------------------------*\
| scan2foam RANS template — turbulent viscosity (wall functions, y+ 30-300).     |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "${FOAM_CASE}/system/include/caseDefinition"

dimensions      [0 2 -1 0 0 0 0];
internalField   uniform $nutInlet;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            calculated;
        value           uniform $nutInlet;
    }
    outlet
    {
        type            calculated;
        value           uniform $nutInlet;
    }
    "(top|sides)"
    {
        type            slip;
    }
    ground
    {
        type            nutUSpaldingWallFunction;   // continuous over y+ range
        value           uniform 0;
    }
    $carPatches
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
}

// ************************************************************************* //
